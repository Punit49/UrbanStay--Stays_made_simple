<% layout("/layouts/boilerplate.ejs") %>

<% block('styles').append(`
  <link rel="stylesheet" href="/stylesheets/starability-slot.min.css">
`) %>

<main>
    <div class="row showListing">
        <div class="col-7 listingInfo">
            <div class="card listingDetailsCard">
                <h3 class="cardTitle mb-4"><%= listing.title %></h3>
                <img src="<%= listing.image.url %>" class="card-img-top listingDetailsImg" alt="listing_image">

                <h6 class="mt-2">
                    <i>Owned By: <%= listing.owner.username %> </i>
                </h6>

                <div class="card-body detailsCardBody">
                    <p class="card-description"><%= listing.description %></p>
                    <p class="card-price fw-bold"><%= listing.price.toLocaleString("en-IN", {style: "currency", currency: "INR", maximumFractionDigits: 0}) %>/Night</p>
                    
                    <div class="listingLocation">
                        <span class="card-location"><%= listing.location %>, </span>
                        <span class="card-country"><%= listing.country %></span>
                    </div>
    
                    <% if(curUser && curUser._id.equals(listing.owner._id)) { %>
                        <div class="listingDetailsBtns mt-4 mb-3">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">Edit Listing</a>
                            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                                <button class="btn mainBtn">Delete Listing</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>

            <hr class="col-7 mb-5 mt-4 w-100">
            
            <div class="mapBox w-100 mb-4">
                <h3 class="mb-4">Where you'll Be</h3>
                <div id="map">

                </div>
            </div>
        </div>



        <% if(isLogin) { %>
            <hr class="col-7 mb-5 mt-4">

            <div class="col-7 mb-4 p-4 rounded-3 reviewBox">
    
                <h4 class="mb-4">Leave a Review</h4>
                <form method="post" action="/listings/<%= listing._id%>/reviews" class="needs-validation" novalidate>
                    <div class="ratingStarWrapper">
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="1 rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" cols="30" rows="6" class="form-control reviewTextArea" id="comment" placeholder="Share your experience with this place..." required></textarea>
                        <div class="valid-feedback">Comment Looks Good</div>
                        <div class="invalid-feedback">Please Write some comments</div>
                    </div>
                    <button class="btn btn-success mt-2">Submit</button>
                </form>
            </div>
        <% } %>    
        
        <% if(listing.reviews.length > 0) { %>
            <hr class="col-7 mb-4 mt-4">
            
            <div class="row col-7 row-cols-2 row-cols-sm-1 g-3 mb-5 p-4 allReviews">
                <h3 class="mb-3">User Reviews </h3>
    
                <% for (const review of listing.reviews.reverse()) { %>
                    <div class="col review">
                        <div class="card h-100">
                            <div class="card-body d-flex justify-content-between reviewBody">
                                <div class="cardContent">
                                    <p class="starability-result" data-rating=<%=review.rating %> </p>
                                    <p class="card-text fs-4 fw-bold"><small><i>@<%= review.author.username %></i></small></p>
                                    <p class="card-text"><%= review.comment %></p>
                                </div>
                                <% if(curUser && review.author._id.equals(curUser._id)) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                <% } %>   
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>    

    </div>
</main>

<script type="application/json" id="listing-data">
  <%- JSON.stringify(listing) %>
</script>

<script>
  const listingData = document.getElementById("listing-data").textContent;
  const listing = JSON.parse(listingData);
</script>

<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
crossorigin=""></script>

<script defer src="/scripts/map.js"></script>
